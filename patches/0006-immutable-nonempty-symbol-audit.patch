+  // The signature snapshot is nonempty for ordinary literal modules. Each
+  // entry is a value string (no mutable declaration, type or scope references).
+  // Equality is diagnostic-only and never bypasses a fresh resolution.
+  private static NonemptySymbolAudit CaptureNonemptyNames(ModuleResolutionResult result) {
+    var names = result.Signatures
+      .OrderBy(p => p.Key.FullName, StringComparer.Ordinal)
+      .SelectMany(p => p.Value.TopLevels.Keys.Select(n => "top:" + p.Key.FullName + ":" + n)
+        .Concat(p.Value.StaticMembers.Keys.Select(n => "static:" + p.Key.FullName + ":" + n))
+        .Concat(p.Value.Ctors.Keys.Select(n => "ctor:" + p.Key.FullName + ":" + n)))
+      .OrderBy(n => n, StringComparer.Ordinal)
+      .ToImmutableArray();
+    return new NonemptySymbolAudit(1, names);
+  }
