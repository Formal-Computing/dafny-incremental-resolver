+  private static readonly bool ResearchImmutableExportSummary =
+    Environment.GetEnvironmentVariable("DAFNY_RESEARCH_IMMUTABLE_EXPORT_SUMMARY") == "1";
+
+  // A hit replaces every mutable return object with one owned by the CURRENT
+  // compilation; the shared summary contains only primitive, immutable values.
+  private ModuleResolutionResult ResolveEmptyExportSummary(CompilationData compilation, ModuleDecl decl) {
+    EmptyExportSummary? currentSummary;
+    lock (cache.ResearchEmptyExportLock) {
+      currentSummary = cache.ResearchEmptyExportSummary;
+    }
+    if (currentSummary is { SchemaVersion: 1, ValidatedEmpty: true }) {
+      Interlocked.Increment(ref cache.ResearchExportSummaryHits);
+      logger.LogInformation("ResearchExportSummary|HIT|{Module}", decl.FullName);
+      return new ModuleResolutionResult(
+        decl, new BatchErrorReporter(decl.Options),
+        new Dictionary<ModuleDefinition, ModuleSignature>(),
+        new Dictionary<TopLevelDeclWithMembers, Dictionary<string, MemberDecl>>());
+    }
+
+    // Do NOT assume the summary is safe without first checking the exact
+    // result contract against the real pinned resolver implementation.
+    var resolved = base.ResolveModuleDeclaration(compilation, decl);
+    Interlocked.Increment(ref cache.ResearchExportSummaryMisses);
+    logger.LogInformation("ResearchExportSummary|MISS|{Module}", decl.FullName);
+    if (ReferenceEquals(resolved.ResolvedDeclaration, decl) &&
+        resolved.Signatures.Count == 0 &&
+        resolved.ClassMembers.Count == 0 &&
+        resolved.ErrorReporter.AllMessages.Count == 0) {
+      lock (cache.ResearchEmptyExportLock) {
+        cache.ResearchEmptyExportSummary = new EmptyExportSummary(1, true);
+      }
+    } else {
+      // Fail closed on changed upstream semantics or nonempty diagnostics.
+      logger.LogWarning("ResearchExportSummary contract failed for {Module}; " +
+                        "no memoization authorized.", decl.FullName);
+    }
+    return resolved;
+  }
