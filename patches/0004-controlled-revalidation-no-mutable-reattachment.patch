+  // A deliberately partial diagnostic/symbol-name digest. It only flags
+  // suspicious collisions; equality never constitutes proof of equivalence.
+  private static byte[] ResearchObservationDigest(ModuleResolutionResult result) {
+    using var hasher = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
+    AppendText(hasher, "dafny-audit-observation-v1");
+    AppendText(hasher, result.ResolvedDeclaration.FullName);
+    foreach (var pair in result.Signatures.OrderBy(x => x.Key.FullName, StringComparer.Ordinal)) {
+      AppendText(hasher, pair.Key.FullName);
+      foreach (var n in pair.Value.TopLevels.Keys.OrderBy(x => x, StringComparer.Ordinal)) {
+        AppendText(hasher, "top:" + n);
+      }
+      foreach (var n in pair.Value.StaticMembers.Keys.OrderBy(x => x, StringComparer.Ordinal)) {
+        AppendText(hasher, "member:" + n);
+      }
+      foreach (var n in pair.Value.Ctors.Keys.OrderBy(x => x, StringComparer.Ordinal)) {
+        AppendText(hasher, "ctor:" + n);
+      }
+    }
+    foreach (var group in result.ClassMembers.OrderBy(x => x.Key.FullName, StringComparer.Ordinal)) {
+      AppendText(hasher, group.Key.FullName);
+      foreach (var n in group.Value.Keys.OrderBy(x => x, StringComparer.Ordinal)) {
+        AppendText(hasher, n);
+      }
+    }
+    foreach (var diagnostic in result.ErrorReporter.AllMessages
+      .Select(x => x.ToString()).OrderBy(x => x, StringComparer.Ordinal)) {
+      AppendText(hasher, diagnostic);
+    }
+    return hasher.GetHashAndReset();
+  }
+
+  private void AuditFreshResult(ModuleDecl decl, byte[] key, ModuleResolutionResult fresh) {
+    var observation = ResearchObservationDigest(fresh);
+    var candidate = Convert.ToHexString(key);
+    bool existed;
+    bool equal = false;
+    lock (cache.ResearchAuditFingerprints) {
+      existed = cache.ResearchAuditFingerprints.TryGetValue(candidate, out var old);
+      if (existed) {
+        equal = old!.AsSpan().SequenceEqual(observation);
+        if (equal) cache.ResearchAuditEqual++;
+        else cache.ResearchAuditDifferent++;
+      }
+      if (cache.ResearchAuditFingerprints.Count >= 2048) {
+        cache.ResearchAuditFingerprints.Clear();
+      }
+      cache.ResearchAuditFingerprints[candidate] = observation;
+      cache.ResearchAuditCandidates++;
+    }
+    if (existed && !equal) {
+      logger.LogWarning("Research candidate fingerprint collision or context difference " +
+        "for {Module}; freshly resolved graph was returned.", decl.FullName);
+    } else if (existed) {
+      logger.LogDebug("Research candidate matched primitive audit digest for {Module}; " +
+        "freshly resolved graph was returned.", decl.FullName);
+    }
+  }
